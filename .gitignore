# WordPress Plugin - KW Security
# Ignore common development and system files

# IDE files
.idea/
.vscode/
*.sublime-*

# System files
.DS_Store
Thumbs.db
desktop.ini

# Log files
*.log
error_log

# Temporary files
*.tmp
*.temp
*~

# Backup files
*.bak
*.backup

# Compressed files
*.zip
*.tar.gz
*.rar

# Development files
node_modules/
.sass-cache/
*.map

# WordPress specific
wp-config-local.php
.htaccess.local

.github
.gitignore

# Release build artifact — generated by .github/workflows/release.yml
# alongside kw-security.zip (already ignored above) and uploaded to the
# update server. Never committed; the tagged release is the record.
/info.json
